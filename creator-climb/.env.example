# Railway provides DATABASE_URL automatically when you add a Postgres plugin.
# For local testing only, point this at your own Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/creator_climb

# Set this to a strong password - this is what you type in to sign into /admin
ADMIN_PASSWORD=change-me-to-something-strong

# Set this to any long random string - used to sign session cookies
SESSION_SECRET=change-me-to-a-random-string

NODE_ENV=production
