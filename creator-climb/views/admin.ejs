<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin — Creator Climb</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>

<header>
  <div class="brand-row">
    <div class="brand">
      <span class="brand-mark display">CREATOR CLIMB</span>
      <span class="brand-sub">admin dashboard</span>
    </div>
    <div class="top-actions">
      <a href="/" class="btn-ghost">View public board</a>
      <form method="POST" action="/logout" style="display:inline;">
        <button type="submit" class="btn-ghost">Sign out</button>
      </form>
    </div>
  </div>
</header>

<nav>
  <a href="/admin" class="nav-btn active">Manage creators</a>
</nav>

<main>
  <h2 class="section-title"><%= editTarget ? 'Edit creator' : 'Add a creator' %></h2>
  <p class="section-desc">Update numbers whenever you check a creator's platform. Scores recompute automatically the moment you save.</p>

  <div class="form-card">
    <form method="POST" action="<%= editTarget ? '/admin/creators/' + editTarget.id : '/admin/creators' %>">
      <div class="field-row">
        <div class="field">
          <label>Name</label>
          <input type="text" name="name" required value="<%= editTarget ? editTarget.name : '' %>">
        </div>
        <div class="field">
          <label>Handle</label>
          <input type="text" name="handle" placeholder="@handle" value="<%= editTarget ? (editTarget.handle || '') : '' %>">
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Platform</label>
          <select name="platform">
            <% ['Twitch','YouTube','TikTok','Instagram'].forEach(p => { %>
              <option <%= editTarget && editTarget.platform === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label>Category</label>
          <input type="text" name="category" placeholder="gaming, vlog, etc." value="<%= editTarget ? (editTarget.category || '') : '' %>">
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Followers</label>
          <input type="number" name="followers" value="<%= editTarget ? editTarget.followers : 0 %>">
        </div>
        <div class="field">
          <label>Avg viewers</label>
          <input type="number" name="avg_viewers" value="<%= editTarget ? editTarget.avg_viewers : 0 %>">
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Hours watched (last 24h)</label>
          <input type="number" name="hours_watched" value="<%= editTarget ? editTarget.hours_watched : 0 %>">
        </div>
        <div class="field">
          <label>Growth rate (24h %)</label>
          <input type="number" step="0.1" name="growth_rate" value="<%= editTarget ? editTarget.growth_rate : 0 %>">
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Monetization score (0-100, your estimate)</label>
          <input type="number" name="monetization_score" value="<%= editTarget ? editTarget.monetization_score : 0 %>">
        </div>
        <div class="field">
          <label>Community activity score (0-100, your estimate)</label>
          <input type="number" name="community_score" value="<%= editTarget ? editTarget.community_score : 0 %>">
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Streak (days posting)</label>
          <input type="number" name="streak" value="<%= editTarget ? editTarget.streak : 0 %>">
        </div>
        <div class="field" style="display:flex; align-items:flex-end;">
          <div class="check-row" style="margin-bottom:10px;">
            <input type="checkbox" id="live" name="live" <%= editTarget && editTarget.live ? 'checked' : '' %>>
            <label for="live" style="margin:0;">Live right now</label>
          </div>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn-primary"><%= editTarget ? 'Save changes' : 'Add creator' %></button>
        <% if (editTarget) { %><a href="/admin" class="btn-ghost">Cancel</a><% } %>
      </div>
    </form>
  </div>

  <h2 class="section-title">Board — <%= creators.length %> / 50</h2>
  <div class="formula-box">
    <b>Scoring model:</b> <%= Math.round(weights.avgViewers*100) %>% avg viewers, <%= Math.round(weights.hoursWatched*100) %>% hours watched, <%= Math.round(weights.growthRate*100) %>% growth, <%= Math.round(weights.monetization*100) %>% monetization, <%= Math.round(weights.community*100) %>% community. Ranked live below.
  </div>

  <% if (creators.length === 0) { %>
    <div class="empty-state">
      <h3>No creators yet</h3>
      <p>Add your first one using the form above.</p>
    </div>
  <% } else { %>
    <% creators.forEach((c, i) => { %>
      <div class="board-row admin-row <%= i < 3 ? 'top3' : '' %>">
        <div class="rank-num"><%= i + 1 %></div>
        <div class="creator-info">
          <div class="avatar" style="background:<%= ({Twitch:'#9147FF',YouTube:'#FF3D3D',TikTok:'#25F4EE',Instagram:'#E1306C'})[c.platform] || '#555' %>"><%= (c.name || '??').slice(0,2).toUpperCase() %></div>
          <div>
            <div class="creator-name"><%= c.name %> <% if (c.live) { %><span class="live-badge">LIVE</span><% } %></div>
            <div class="creator-sub"><%= c.platform %> · <%= c.category || '—' %></div>
          </div>
        </div>
        <div class="stat-col hide-mobile">
          <div class="stat-label">Growth</div>
          <div class="<%= Number(c.growth_rate) >= 0 ? 'delta-up' : 'delta-down' %>"><%= Number(c.growth_rate) >= 0 ? '▲' : '▼' %> <%= Math.abs(Number(c.growth_rate)) %>%</div>
        </div>
        <div class="stat-col">
          <div class="stat-label">Score</div>
          <div><%= c.score %></div>
        </div>
        <div class="row-actions">
          <a href="/admin/edit/<%= c.id %>" class="btn-ghost">Edit</a>
          <form method="POST" action="/admin/creators/<%= c.id %>/delete" onsubmit="return confirm('Remove ' + <%- JSON.stringify(c.name) %> + ' from the board?');" style="display:inline;">
            <button type="submit" class="btn-danger">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } %>

  <div class="note-box">
    <b>Snapshots for trend history:</b> every time you hit the button below, today's ranks and scores are saved to <code>score_history</code> so you can build growth-over-time charts later.
    <form method="POST" action="/admin/snapshot" style="margin-top:10px;">
      <button type="submit" class="btn-ghost">Save today's snapshot</button>
    </form>
  </div>
</main>

</body>
</html>
